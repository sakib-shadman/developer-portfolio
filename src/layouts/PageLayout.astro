---
/** Standard page chrome: header + main + footer around BaseLayout. Pages use this. */
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import type { JsonLd } from '../lib/seo/jsonld';
import { defaultCardAlt } from '../lib/seo/og';
import { getHomeSections, getProfile } from '../lib/content/queries';

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  imageAlt?: string;
  siteName?: string;
  jsonLd?: JsonLd[];
  type?: 'website' | 'article' | 'profile';
  /** Always emit noindex and no canonical, regardless of PUBLIC_INDEXABLE (404 page). */
  noindex?: boolean;
}

const [profile, home] = await Promise.all([getProfile(), getHomeSections()]);
// Pages on the default OG card describe it ("<name>, <title>"), not the page title.
const imageAlt = Astro.props.imageAlt ?? (Astro.props.image ? undefined : defaultCardAlt(profile));
---

<BaseLayout siteName={profile.name} {...Astro.props} {imageAlt}>
  <Header slot="header" name={profile.name} resume={profile.resume} sections={home.rendered} />
  <slot />
  <Footer slot="footer" rss name={profile.name} location={profile.location} resume={profile.resume} />
</BaseLayout>
