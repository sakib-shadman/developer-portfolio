---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/home/Hero.astro';
import Stats from '../components/home/Stats.astro';
import Skills from '../components/home/Skills.astro';
import Experience from '../components/home/Experience.astro';
import ContactCta from '../components/home/ContactCta.astro';
import { getHomeSections, getProfile } from '../lib/content/queries';

const [profile, home] = await Promise.all([getProfile(), getHomeSections()]);
---

<PageLayout title={`${profile.name} — ${profile.title}`} description={profile.intro}>
  <Hero profile={profile} />
  <Stats stats={profile.stats} />
  <Skills groups={home.skillGroups} eyebrow={home.eyebrows.skills ?? ''} />
  <Experience items={home.experience} eyebrow={home.eyebrows.experience ?? ''} />
  {/* PF-14 insertion point: <FeaturedProjects eyebrow={home.eyebrows.projects} /> (section#work, "03 — Projects") */}
  {/* PF-33 insertion point: <HomeWriting eyebrow={home.eyebrows.writing} /> (section#writing, "04 — Writing") */}
  <ContactCta profile={profile} />
</PageLayout>
