---
// Walking skeleton — replaced by the real home page in PF-12.
import PageLayout from '../layouts/PageLayout.astro';
import { getProfile } from '../lib/content/queries';

const profile = await getProfile();
---

<PageLayout title={`${profile.name} — ${profile.title}`} description={profile.intro}>
  <section class="wrap" style="padding-block: var(--page-top)">
    <span class="eyebrow">{profile.focus.join(' · ')}</span>
    <h1 style="font-family: var(--font-display); font-size: var(--h1-page); letter-spacing: var(--tracking-display)">
      {profile.name}
    </h1>
    <p style="color: var(--muted); max-width: 540px">{profile.intro}</p>
  </section>
</PageLayout>
