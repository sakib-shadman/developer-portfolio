---
/** /contact, email only (PF-19, FR-11.1-11.3, ADR-0004). The form is M5 and not built here. */
import PageLayout from '../layouts/PageLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Icon from '../components/ui/Icon.astro';
import ProfileLinks from '../components/ui/ProfileLinks.astro';
import ContactDirect from '../components/contact/ContactDirect.astro';
import { getProfile } from '../lib/content/queries';
import { placeLine } from '../lib/contact';
import { breadcrumbLd } from '../lib/seo/jsonld';
import { siteOrigin } from '../lib/seo/text';

const profile = await getProfile();
const place = placeLine(profile.location, profile.timezone);
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Contact', href: '/contact' },
];
---

<PageLayout
  title={`Contact — ${profile.name}`}
  description={profile.availability ?? `Contact ${profile.name}.`}
  path="/contact"
  jsonLd={[breadcrumbLd(crumbs, '/contact', siteOrigin(Astro.site))]}
>
  <div class="wrap page">
    <div class="col">
      <Breadcrumbs items={crumbs} />
      <SectionHeading level="h1" title="Let's talk." />
      {profile.availability && <p class="lead">{profile.availability}</p>}

      <ContactDirect email={profile.email} />

      <ProfileLinks
        variant="pill"
        links={profile.links}
        kinds={['linkedin', 'github', 'medium']}
        aria-label="Profiles"
      />

      {(place || profile.replyTime) && (
        <dl class="facts">
          {place && (
            <div class="fact">
              <dt>
                <Icon name="pin" size={20} color="var(--acc)" />
                Location
              </dt>
              <dd>{place}</dd>
            </div>
          )}
          {profile.replyTime && (
            <div class="fact">
              <dt>
                <Icon name="mail" size={20} color="var(--acc)" />
                Reply time
              </dt>
              <dd>{profile.replyTime}</dd>
            </div>
          )}
        </dl>
      )}
    </div>
  </div>
</PageLayout>

<style>
  .page {
    padding-block: var(--page-top) var(--section-gap);
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 680px;
  }
  .lead {
    font-size: 19px;
    color: var(--muted);
  }
  .facts {
    display: flex;
    flex-direction: column;
    margin: 8px 0 0;
    padding: 0;
    border-bottom: 1px solid var(--border);
  }
  .fact {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 16px 0;
    border-top: 1px solid var(--border);
  }
  dt {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--text-sm);
    color: var(--muted);
  }
  dd {
    margin: 0;
    padding-left: 30px;
    font-weight: 500;
  }
</style>
