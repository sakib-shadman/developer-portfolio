---
/**
 * Inline stroke icons (HANDOFF §3: inline SVG, aria-hidden). Decorative only —
 * the surrounding link/button carries the accessible name.
 */
const PATHS = {
  'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6"/>',
  'arrow-up': '<path d="M12 19V5M6 11l6-6 6 6"/>',
  external: '<path d="M7 17L17 7M8 7h9v9"/>',
  download: '<path d="M12 4v12M6 10l6 6 6-6M5 20h14"/>',
  rss: '<path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
  pin: '<path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12z"/><circle cx="12" cy="9" r="2.5"/>',
} as const;

export type IconName = keyof typeof PATHS;

interface Props {
  name: IconName;
  size?: number;
  /** Stroke colour; defaults to currentColor. */
  color?: string;
  class?: string;
}

const { name, size = 16, color = 'currentColor', class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke={color}
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={PATHS[name]}
/>
