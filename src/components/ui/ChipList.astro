---
/** A wrapped row of chips as a real list (screen readers announce the count). Hidden when empty. */
import Chip from './Chip.astro';

interface Props {
  items: string[];
  label?: string;
}
const { items, label } = Astro.props;
---

{items.length > 0 && (
  <ul class="chips" aria-label={label}>
    {items.map((item) => (
      <li>
        <Chip>{item}</Chip>
      </li>
    ))}
  </ul>
)}

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
