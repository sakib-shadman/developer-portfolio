---
/**
 * Per-page metadata (FR-14). Indexing is controlled by PUBLIC_INDEXABLE (plan §2.7):
 * false for previews, staging and 0.x; true from v1.0 production.
 */
import { DEFAULT_OG_PATH, OG_SIZE, absoluteUrl, seoDescription, siteOrigin } from '../../lib/seo/text';
import { serializeJsonLd, type JsonLd } from '../../lib/seo/jsonld';

interface Props {
  title: string;
  description: string;
  /** Path relative to the site root, e.g. "/projects". Defaults to the current path. */
  path?: string;
  /** Site-relative path of the share image; defaults to the generated /og/default.png. */
  image?: string;
  imageAlt?: string;
  /** og:site_name (the owner's name). */
  siteName?: string;
  /** schema.org blocks for this page (see lib/seo/jsonld.ts). */
  jsonLd?: JsonLd[];
  type?: 'website' | 'article' | 'profile';
  /** Always emit noindex and no canonical, regardless of PUBLIC_INDEXABLE (404 page). */
  noindex?: boolean;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  image = DEFAULT_OG_PATH,
  imageAlt,
  siteName,
  jsonLd = [],
  type = 'website',
  noindex = false,
} = Astro.props;
const site = siteOrigin(Astro.site);
const canonical = absoluteUrl(path, site);
const ogImage = absoluteUrl(image, site);
const desc = seoDescription(description);
const indexable = !noindex && import.meta.env.PUBLIC_INDEXABLE === 'true';
---

<title>{title}</title>
<meta name="description" content={desc} />
{!noindex && <link rel="canonical" href={canonical} />}
{!indexable && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={desc} />
{!noindex && <meta property="og:url" content={canonical} />}
{siteName && <meta property="og:site_name" content={siteName} />}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(OG_SIZE.width)} />
<meta property="og:image:height" content={String(OG_SIZE.height)} />
<meta property="og:image:alt" content={imageAlt ?? title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt ?? title} />
{jsonLd.map((block) => (
  <script type="application/ld+json" set:html={serializeJsonLd(block)} />
))}
