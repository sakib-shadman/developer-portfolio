---
/** HANDOFF §8: breadcrumbs as nav[aria-label="Breadcrumb"]; last item is the current page. */
export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="crumbs">
  <ol role="list">
    {items.map((item, i) => {
      const last = i === items.length - 1;
      return (
        <li>
          {last || !item.href ? (
            <span aria-current={last ? 'page' : undefined} class:list={{ here: last }}>
              {item.label}
            </span>
          ) : (
            <a href={item.href}>{item.label}</a>
          )}
          {!last && (
            <span class="sep" aria-hidden="true">
              /
            </span>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .crumbs {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted);
  }
  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sep {
    padding-inline: 0.5ch;
  }
  .here {
    color: var(--text);
  }
  a:hover {
    color: var(--text);
    opacity: 1;
  }
</style>
