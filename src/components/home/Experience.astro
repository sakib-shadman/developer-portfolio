---
/** Experience (FR-03): date column + content per role, current first. Every missing field is hidden. */
import type { ExperienceItem } from '../../lib/content/types';
import { formatDateRange } from '../../lib/date-range';
import Badge from '../ui/Badge.astro';
import ChipList from '../ui/ChipList.astro';
import LinkPill from '../ui/LinkPill.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  items: ExperienceItem[];
  eyebrow: string;
}
const { items, eyebrow } = Astro.props;
---

{items.length > 0 && (
  <section id="experience" class="wrap" aria-labelledby="experience-title">
    <SectionHeading
      class="intro"
      eyebrow={eyebrow}
      title="Where I've worked"
      id="experience-title"
      lead="Roles, responsibilities and the technologies behind them."
    />
    <ol class="list" role="list">
      {items.map((e) => {
        const dates = formatDateRange(e);
        return (
          <li class="row">
            {/* Always rendered so the content column stays aligned across rows; children are conditional. */}
            <div class="when">
              {dates && <span class="dates">{dates}</span>}
              {e.current && <Badge>Current</Badge>}
            </div>
            <div class="what">
              <h3>
                {e.title && <>{e.title} </>}
                <span class="acc">
                  {e.title ? '· ' : ''}
                  {e.company}
                </span>
              </h3>
              {e.description && <p class="desc">{e.description}</p>}
              {e.responsibilities.length > 0 && (
                <ul class="bullets">
                  {e.responsibilities.map((r) => (
                    <li>{r}</li>
                  ))}
                </ul>
              )}
              {e.achievements.length > 0 && (
                <ul class="bullets">
                  {e.achievements.map((a) => (
                    <li>{a}</li>
                  ))}
                </ul>
              )}
              <ChipList items={e.technologies.map((t) => t.name)} label={`Technologies at ${e.company}`} />
              {e.companyUrl && (
                <div>
                  <LinkPill variant="secondary" href={e.companyUrl}>
                    Company site<span class="sr-only">: {e.company}</span>
                  </LinkPill>
                </div>
              )}
            </div>
          </li>
        );
      })}
    </ol>
  </section>
)}

<style>
  section {
    display: flex;
    flex-wrap: wrap;
    gap: 40px 64px;
    padding-top: var(--section-gap);
    padding-bottom: 56px;
  }
  .intro {
    flex: 1 1 280px;
  }
  .list {
    flex: 2 1 560px;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    padding-block: 32px;
    border-top: 1px solid var(--border);
  }
  .row:last-child {
    border-bottom: 1px solid var(--border);
  }
  .when {
    flex: 1 1 160px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  .dates {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .when:empty {
      display: none;
    }
  }
  .what {
    flex: 3 1 320px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  h3 {
    font-family: var(--font-display);
    font-size: 22px;
  }
  .acc {
    color: var(--acc-text);
  }
  .desc,
  .bullets {
    margin: 0;
    color: var(--muted);
  }
  .bullets {
    padding-left: 18px;
  }
</style>
