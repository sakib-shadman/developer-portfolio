---
/**
 * Article card (Main.dc.html "04 — Writing", Blog.dc.html): optional thumbnail, meta line, title,
 * excerpt, tags and a "Read on Medium ↗" pill that stretches over the whole card (one link, no
 * nested interactive elements). Missing fields are hidden. Reused by /blog and the home slider.
 * The root is an <article> so it can sit directly in a Slider track.
 */
import { Image } from 'astro:assets';
import type { HTMLAttributes } from 'astro/types';
import Card from '../ui/Card.astro';
import ChipList from '../ui/ChipList.astro';
import LinkPill from '../ui/LinkPill.astro';
import type { ArticleCard } from '../../lib/content/types';
import { formatMeta } from '../../lib/blog';

interface Props extends Omit<HTMLAttributes<'article'>, 'title'> {
  article: ArticleCard;
  /** Heading level for the title: h2 on /blog, h3 inside a home section. */
  headingLevel?: 'h2' | 'h3';
  /** Prefix for the title id so the same article can appear twice on a page. */
  idPrefix?: string;
}

const {
  article,
  headingLevel: Heading = 'h3',
  idPrefix = 'article',
  class: className,
  ...rest
} = Astro.props;
const titleId = `${idPrefix}-${article.id}`;
const meta = formatMeta(article.publishedAt, article.readingMinutes);
const validDate = !Number.isNaN(article.publishedAt.getTime());
const thumb = article.thumbnail;
---

<Card
  as="article"
  mediaHeight={180}
  class:list={['article-card', className]}
  aria-labelledby={titleId}
  {...rest}
>
  <Fragment slot="media">
    {thumb ? (
      <Image
        src={thumb.src}
        alt={thumb.alt}
        widths={[360, 720]}
        sizes="(max-width: 640px) 85vw, 380px"
        loading="lazy"
        class="thumb"
      />
    ) : (
      <svg class="glyph" viewBox="0 0 120 120" fill="none" aria-hidden="true" focusable="false">
        <rect x="30" y="18" width="60" height="84" rx="8" />
        <path d="M44 42h32M44 58h32M44 74h20" />
      </svg>
    )}
  </Fragment>

  {meta && (
    <p class="meta">
      {validDate ? <time datetime={article.publishedAt.toISOString().slice(0, 10)}>{meta}</time> : meta}
    </p>
  )}
  <Heading id={titleId} class="title">
    {article.title}
  </Heading>
  {article.excerpt && <p class="excerpt">{article.excerpt}</p>}
  <ChipList items={article.tags} label="Topics" />
  <div class="links">
    <LinkPill href={article.url} class="read" aria-describedby={titleId}>
      Read on Medium
    </LinkPill>
  </div>
</Card>

<style>
  .article-card {
    position: relative;
  }
  .article-card:hover {
    border-color: var(--acc);
  }
  .thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .glyph {
    width: 96px;
    height: 96px;
    stroke: var(--acc);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.45;
  }
  .meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
  }
  .title {
    font-family: var(--font-display);
    font-size: 21px;
    line-height: 1.3;
  }
  .excerpt {
    color: var(--muted);
    font-size: 15px;
  }
  .links {
    margin-top: auto;
    padding-top: 4px;
  }
  /* Stretched link: the pill's ::after covers the card so the whole card is clickable. */
  .read {
    align-self: flex-start;
  }
  .read::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .article-card:has(.read:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: 3px;
  }
</style>
