---
/**
 * Direct contact (ADR-0004): "Email me" (mailto) + "Copy address". Renders nothing without an email.
 * The form slot is reserved for M5 and appears only when PUBLIC_CONTACT_FORM is "true" AND a form
 * is actually provided (FR-11: never present a form before delivery is configured).
 */
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { linkAttrs } from '../../lib/link';
import { mailtoHref } from '../../lib/contact';

interface Props {
  email?: string | undefined;
  formEnabled?: boolean;
}
const { email, formEnabled = import.meta.env.PUBLIC_CONTACT_FORM === 'true' } = Astro.props;
const mail = email ? linkAttrs(mailtoHref(email)) : null;
const showForm = formEnabled && Astro.slots.has('form');
---

{mail && email && (
  <div class="direct" data-contact-direct>
    <p class="address">
      <span class="label">Email</span>
      <span class="value">{email}</span>
    </p>
    <div class="actions">
      <Button variant="solid" href={mail.href}>
        Email me
      </Button>
      <Button
        variant="outline"
        size="lg"
        type="button"
        data-copy={email}
        aria-describedby="copy-status"
        hidden
      >
        <Icon name="copy" color="var(--acc)" />
        Copy address
      </Button>
    </div>
    <p id="copy-status" role="status" class="status"></p>
  </div>
)}
{showForm && (
  <div class="form-card">
    <slot name="form" />
  </div>
)}

<script>
  import { copyAddress, createAnnouncer } from '../../lib/contact';
  const sched = {
    frame: (cb: () => void) => requestAnimationFrame(cb),
    later: (cb: () => void, ms: number) => setTimeout(cb, ms),
    cancel: (h: unknown) => {
      if (typeof h === 'number') {
        cancelAnimationFrame(h);
        clearTimeout(h);
      }
    },
  };
  // The button is rendered hidden: without JS it would do nothing.
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const region = btn.closest('[data-contact-direct]')?.querySelector('[role="status"]');
    const announce = region ? createAnnouncer(region, sched) : undefined;
    btn.hidden = false;
    btn.addEventListener('click', async () => {
      announce?.(await copyAddress(btn.dataset.copy ?? '', navigator.clipboard));
    });
  });
</script>

<style>
  .direct {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .address {
    display: flex;
    flex-direction: column;
    margin: 0;
  }
  .label {
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .value {
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .actions :global([hidden]) {
    display: none;
  }
  .status {
    margin: 0;
    min-height: 1.6em;
    font-size: 14px;
    color: var(--acc-text);
  }
  .form-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: clamp(24px, 4vw, 40px);
  }
</style>
