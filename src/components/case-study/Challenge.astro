---
/** A hard problem and how it was resolved (design: Challenge / Resolution card). */
interface Props {
  challenge: string;
  resolution: string;
}
const { challenge, resolution } = Astro.props;
---

<div class="card">
  <div class="col">
    <span class="tag">Challenge</span>
    <p>{challenge}</p>
  </div>
  <div class="col">
    <span class="tag resolution">Resolution</span>
    <p>{resolution}</p>
  </div>
</div>

<style>
  .card {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 20px;
    padding: 24px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .resolution {
    color: var(--acc-text);
  }
  p {
    margin: 0;
    color: var(--text);
    font-size: 16px;
    line-height: 1.65;
  }
</style>
