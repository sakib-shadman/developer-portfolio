---
/** Body-text styles for case-study content (rendered MDX elements are unscoped, hence :global). */
---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    display: flex;
    flex-direction: column;
    gap: 16px;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.75;
  }
  /* A section written in MDX sits in this flex column: cancel the gap so spacing matches page sections. */
  .prose > :global(.sec) {
    margin-top: -16px;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(h3) {
    margin: 0;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 20px;
  }
  .prose :global(li + li) {
    margin-top: 6px;
  }
  .prose :global(h3) {
    color: var(--text);
    font-family: var(--font-display);
    font-size: 21px;
    line-height: 1.3;
  }
  .prose :global(a) {
    color: var(--acc-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose :global(strong) {
    color: var(--text);
  }
  .prose :global(code:not(pre code)) {
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.88em;
  }
  /* Shiki output: keep its token colours, use the card surface for the block. */
  .prose :global(pre.astro-code) {
    margin: 0;
    padding: 24px;
    overflow-x: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background-color: var(--surface) !important;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.8;
  }
  .prose :global(pre.astro-code code) {
    font-family: inherit;
  }
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }
</style>
