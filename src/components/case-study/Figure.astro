---
/** Image with a required alt text and optional caption. `src` is an imported asset (astro:assets). */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}
const { src, alt, caption } = Astro.props;
---

<figure>
  <Image
    src={src}
    alt={alt}
    widths={[480, 800, 1200]}
    sizes="(max-width: 800px) 100vw, 800px"
    loading="lazy"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  figure {
    margin: 8px 0 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  figure :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
  }
  figcaption {
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
  }
</style>
