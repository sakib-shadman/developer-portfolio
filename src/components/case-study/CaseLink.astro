---
/**
 * Link inside case-study MDX (registered as `a`). Goes through linkAttrs (NFR-03): unsafe hrefs
 * render as plain text, external links open in a new tab with rel and a screen-reader hint.
 */
import type { HTMLAttributes } from 'astro/types';
import { linkAttrs } from '../../lib/link';

type Props = Omit<HTMLAttributes<'a'>, 'target' | 'rel'>;
const { href, ...rest } = Astro.props;
const link = linkAttrs(href?.toString());
---

{link ? (
  <a href={link.href} target={link.target} rel={link.rel} {...rest}>
    <slot />
    {link.external && <span class="sr-only">(opens in a new tab)</span>}
  </a>
) : (
  <span>
    <slot />
  </span>
)}
