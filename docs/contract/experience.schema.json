{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "company": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "startDate": {},
    "endDate": {
      "anyOf": [
        {},
        {
          "type": "null"
        }
      ]
    },
    "description": {
      "type": "string"
    },
    "responsibilities": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "achievements": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "technologies": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "companyUrl": {
      "type": "string",
      "format": "uri"
    },
    "status": {
      "default": "draft",
      "type": "string",
      "enum": ["draft", "published"]
    }
  },
  "required": ["company"]
}
