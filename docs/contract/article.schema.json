{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "publishedAt": {},
    "excerpt": {
      "type": "string",
      "maxLength": 240
    },
    "thumbnail": {
      "type": "string",
      "minLength": 1
    },
    "thumbnailAlt": {
      "type": "string"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "readingMinutes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "status": {
      "default": "published",
      "type": "string",
      "enum": ["draft", "published"]
    }
  },
  "required": ["title", "url", "publishedAt"]
}
